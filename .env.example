# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/comp3123_assignment1
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Rate limiting (optional overrides; defaults shown)
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300

# Logging (optional overrides; defaults shown)
# LOG_DIR=logs
# LOG_FILE=logs/app.log
# LOG_TO_FILE=true
# LOG_TO_CONSOLE=true

NODE_ENV=development
