{
  "info": {
    "name": "COMP3123 Assignment 1",
    "description": "Employee API collection.\n\nHow to use:\n1. Set the `baseUrl` collection variable (local: http://localhost:3000, or your Vercel URL).\n2. Run `00 - Start test run` first. It creates a unique run id so usernames and emails do not collide on a second run.\n3. Run the folders in order. Login requests save `token` and `secondToken`; employee requests save `eidA` and `eidB`.\n4. The auth endpoints allow 20 requests per 15 minutes per IP. Wait for the window to reset before another full run.\n5. The rate-limit folder is meant to be run separately with about 25 iterations (see its description).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "secondToken",
      "value": ""
    },
    {
      "key": "tamperedToken",
      "value": ""
    },
    {
      "key": "eidA",
      "value": ""
    },
    {
      "key": "eidB",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Start test run (run this first)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now().toString(36);",
              "pm.collectionVariables.set('runId', id);",
              "console.log('Test run id: ' + id);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Run id initialised', () => pm.expect(pm.collectionVariables.get('runId')).to.be.a('string').and.not.empty);",
              "pm.test('Health check returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "01 - Health and security",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('Database is connected', () => pm.expect(body.database).to.eql('connected'));",
                  "pm.test('Uptime is reported', () => pm.expect(body.uptime_seconds).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Security headers (Helmet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Content-Type-Options is nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
                  "pm.test('Content-Security-Policy is present', () => pm.expect(pm.response.headers.get('Content-Security-Policy')).to.be.a('string'));",
                  "pm.test('X-Powered-By is removed', () => pm.expect(pm.response.headers.get('X-Powered-By')).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Unknown route returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 404', () => pm.response.to.have.status(404));",
                  "pm.test('Route not found code', () => pm.expect(pm.response.json().error.code).to.eql('ROUTE_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/does-not-exist"
          }
        }
      ]
    },
